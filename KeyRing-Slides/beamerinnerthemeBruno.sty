        \clip (current page.south east)
           -- (current page.north east)
           -- ++(-1.9, 0)
           -- ++(-4.3, -\paperheight)
           -- cycle;

        % Include background image
        \node[
            anchor=south east,
            inner sep=0,
            outer sep=0
        ] at ($(current page.south east)+(-30pt,12pt)$$) {
            \includegraphics[scale=0.33]%width=0.5\paperwidth,height=\paperheight
