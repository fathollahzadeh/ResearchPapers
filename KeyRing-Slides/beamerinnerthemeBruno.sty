        % Add a slight shadow
        \fill[
            gray, path fading=title page picture fading,
            fading angle=-15
        ]
            (current page.south east)
            rectangle
            ++(-10, \dimexpr\paperheight+1cm);                        
    \end{tikzpicture}
    \fi
